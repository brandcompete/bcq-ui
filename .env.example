#### General #######################################################
# Used for project, image and container names: <APP_NAME_SHORT>-<APP_STAGE>-frontend
APP_NAME_SHORT=bc-bcq-ui
APP_STAGE=dev

# make docker compose use bake
COMPOSE_BAKE=true



#### Frontend (nginx) ##############################################
# Host port the site is published on while Traefik is disabled (container port is 9085)
FRONTEND_HOST_PORT=8082



#### Traefik (currently disabled in docker-compose.yaml) ###########
# External network of the shared Traefik stack in front of the site (production: traefik_prod)
TRAEFIK_NETWORK_NAME=traefik_prod
# The public host name Traefik routes to the frontend. Live: bcq-ui.brandcompete.com
# Dev/QA follow infrastructure ADR-0001: {component}.{application}.apps.{stage}.brandcompete.com
WEBSITE_FRONTEND_HOST=<WEBSITE_FRONTEND_HOST>
