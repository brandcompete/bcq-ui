{
  "name": "@martin.ivanov.brandcompete/bcq-ui",
  "version": "3.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "src",
    "lib"
  ],
  "main": "./lib/bcq-ui.min.js",
  "module": "./lib/bcq-ui.min.js",
  "style": "./lib/bcq-ui.min.css",
  "types": "./lib/bcq-ui.min.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/bcq-ui.min.d.ts",
      "import": "./lib/bcq-ui.min.js",
      "default": "./lib/bcq-ui.min.js"
    },
    "./style.css": "./lib/bcq-ui.min.css",
    "./lib/*": "./lib/*",
    "./source": "./src/lib.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.26"
  },
  "appName": "Becquerel UI for Vue3",
  "description": "The Vue3 UI library developed by us at brandcompete GmbH provides a comprehensive and growing set of tools for building modern, consistent user interfaces",
  "vendor": "brandcompete GmbH",
  "vendorUrl": "https://brandcompete.com/",
  "themeColor": "#212121",
  "hostname": "https://becquerel3.brandcompete.com/",
  "website": "https://becquerel3.brandcompete.com/",
  "_hostname": "https://bcq.wemakesites.net/",
  "_website": "https://bcq.wemakesites.net/",
  "changefreq": "weekly",
  "priority": "1.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brandcompete/bcq-ui.git"
  },
  "bugs": {
    "url": "https://github.com/brandcompete/bcq-ui/issues"
  },
  "homepage": "https://github.com/brandcompete/bcq-ui.git",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node bcq-cli/llms.cjs && node bcq-cli/ssr.cjs && npm run build:bundle",
    "preview": "vite preview",
    "bcq:create": "node bcq-cli/create.cjs",
    "bcq:llms": "node bcq-cli/llms.cjs",
    "bcq:ssr": "node bcq-cli/ssr.cjs",
    "build:bundle": "node bcq-cli/types.cjs && vite build -c vite.bundle.config.js && vite build -c vite.bundle.config.js --mode min",
    "prepublishOnly": "npm run build:bundle",
    "dev:bundle": "npm run build:bundle && vite --mode bundle",
    "bcq:types": "node bcq-cli/types.cjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "axios": "^1.15.0",
    "chalk": "^4.1.2",
    "clipboard-copy": "^4.0.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "terser": "^5.51.2",
    "vite": "^7.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue": "^3.5.26",
    "vue-axios": "^3.5.2",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  }
}
