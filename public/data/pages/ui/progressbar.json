        "icon-provider": ["String", false, "'mdi'", "Component <a href='/ui/icon' v-link>icon</a> <code>provider</code>. One of <code>'mdi'</code>, <code>'fa'</code>, <code>'google'</code>, etc."],
        "icon-right": ["String", false, "undefined", "Optional right icon"],
        "indeterminate": ["Boolean", false, false, "Sets progress to indeterminate"],
