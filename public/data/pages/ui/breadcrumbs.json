        "mb-0"
      ]
    }]
  },
  "documentation": {
    "bc-breadcrumbs": {
      "props": {
        "x-align": ["String", false, "'left'", "One of the alignment <a href='/content/utility-css-classes' v-link>utility</a> CSS classes"],
