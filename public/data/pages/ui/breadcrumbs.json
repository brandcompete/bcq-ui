        "default": ["Default" ,"Default JavaScript events"]
      }
    },
    "bc-breadcrumbs-item": {
      "props": {
        "to": ["String", true, "undefined", "Used as <code>'to'</code> or <code>'href'</code> depending on the <code>use-router</code> prop of the parent <code>&lt;bc-breadcrumb /&gt;</code> element"]
      },
      "slots": {
        "default": ["The default Vue slot"]
      },
      "events": {
        "default": ["Default" ,"Default JavaScript events"]
      }
    }
