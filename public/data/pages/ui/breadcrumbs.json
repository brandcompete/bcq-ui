        "underline": ["Boolean", false, true, "Underline links by default"],
        "font-size": ["String", false, "'sm'", "One of the text size <a href='/content/typography' v-link>typography</a> CSS classes"],
        "last-item-disabled": ["Boolean", true, true, "Disable the last breadcrumb item (current route)"],
        "target": ["String", false, "'_self'", "One of the HTML <code>target</code> attribute values"],
