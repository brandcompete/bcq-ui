  "documentation": {
    "bc-avatar-group": {
      "props": {
        "gap": ["Number", false, -12, "Nested avatars overlap offset in pixels (<code>px</code> unit is added automatically). Both negative and positive values are supported"],
        "limit": ["Number", false, 0, "Visible items in the stack. If <code>limit</code> is more than <code>0</code>, the \"+\" avatar is rendered on the right"],
        "limit-color": ["String", false, "'primary'", "\"+\" avatar color, one of the <a href='/content/colors' v-link>UI colors</a>"],
        "limit-elevation": ["String", false, "'md'", "\"+\" avatar elevation, One of the <a href='/content/elevation' v-link>shadow</a> utility CSS classes"],
        "limit-font-weight": ["String", false, "'normal'", "\"+\" avatar font-weight, one of the CSS <code>font-weight</code> <a href='/content/typography' v-link>typography</a> classes"],
        "limit-font-size": ["String", false, "'sm'", "\"+\" avatar font-size. One of the <a href='/content/typography' v-link>typography</a> font-size treatments"],
        "limit-label": ["Function", false, "'+{hiddenAvatars}'", "\"+\" avatar label"],
        "limit-size": ["String", false, "'48px'", "\"+\" avatar <code>width</code> and <code>height</code>"],
        "limit-tile": ["Boolean", false, false, "Renders the \"+\" avatar as square or as circle"],
        "limit-variant": ["String", false, "'outline'", "\"+\" avatar color variant, one of the <a href='/content/colors' v-link>UI color</a> variants"]
