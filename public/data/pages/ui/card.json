{
  "meta": {
    "pageTitle": "Card for Vue3",
    "keywords": [
      "ui card"
    ],
    "links": [
      "documentation",
      "ui"
    ]
  },
  "config": {
    "cards": 3,
    "span": 4,
    "title": true,
    "text": true,
    "actions": true,
    "codeFiles": [{
      "uri": "/code/card.md",
      "title": "component-tags",
      "language": "xml",
      "margin": ["mb-0"]
    }],
    "color": [
      "none"
    ],
    "variant": [
      "solid"
    ]
  },
  "documentation": {
    "bc-card": {
      "props": {
        "border-width": ["Number", false, 2, "One of the border width <a href='/content/utility-css-classes' v-link>utility</a> CSS classes"],
