{
  "meta": {
    "pageTitle": "Grid Layout for Vue3",
    "keywords": [
      "grid",
      "flex",
      "flexbox",
      "css grid",
      "css flex"
    ],
    "links": [
      "documentation",
      "content"
    ]
  },
  "config": {
    "codeFiles": [{
      "uri": "/code/grid.md",
      "title": "component-tags",
      "language": "xml",
      "margin": ["mb-0"]
    }],
    "offset": 4,
    "colColor": "grey",
    "equalColumns": [{
      "cols": 12,
      "swatch": 500,
      "text": 1000,
      "color": "red"
    }, {
      "cols": 11,
      "swatch": 500,
      "text": 950,
      "color": "pink"
    }, {
      "cols": 10,
      "swatch": 500,
      "text": 900,
      "color": "purple"
    }, {
      "cols": 9,
      "swatch": 500,
      "text": 800,
      "color": "deep-purple"
    }, {
      "cols": 8,
      "swatch": 500,
      "text": 700,
      "color": "indigo"
    }, {
      "cols": 7,
      "swatch": 500,
      "text": 50,
      "color": "blue"
    }, {
      "cols": 6,
      "swatch": 500,
      "text": 50,
      "color": "light-blue"
    }, {
      "cols": 5,
      "swatch": 500,
      "text": 50,
      "color": "cyan"
    }, {
      "cols": 4,
      "swatch": 500,
      "text": 50,
      "color": "teal"
    }, {
      "cols": 3,
