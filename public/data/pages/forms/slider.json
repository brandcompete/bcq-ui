      "model:value": 0,
      "step": 5,
      "min": -100,
      "max": 100,
      "name": "slider-2"
    }, {
      "model:value": 0,
      "step": 10,
      "min": -50,
      "max": 50,
      "name": "slider-3"
    }, {
      "model:value": 100,
      "step": 20,
      "min": 0,
      "max": 100,
      "name": "slider-4"
    }]
